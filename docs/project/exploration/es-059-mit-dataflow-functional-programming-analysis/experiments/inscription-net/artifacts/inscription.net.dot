  "t3" -> "p7" [arrowhead="normal", color="#8b949e", label="EvidenceWatermark", style="solid", tooltip="decide.repair -> readiness.watermark"];
  "t3" -> "p1" [arrowhead="normal", color="#8b949e", label="RepairLanded", style="solid", tooltip="decide.repair -> facts.repair_landed"];
