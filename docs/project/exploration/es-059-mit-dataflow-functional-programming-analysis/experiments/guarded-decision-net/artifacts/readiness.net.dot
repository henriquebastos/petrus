    "p6" [color="#58a6ff", fillcolor="#0d1117", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">work</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">PublishRequested</FONT></TD></TR></TABLE>>, shape="ellipse", style="filled", tooltip="effects.publish.work"];
    "t0" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">accept</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="effects.publish.accept\nhandler: anonymous declaration"];
    "t1" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">authorize</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="effects.publish.authorize\nhandler: anonymous declaration"];
    "t2" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">execute</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler: publish</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="effects.publish.execute\nhandler: publish"];
    "t3" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">fire</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler: repair</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="effects.repair.fire\nhandler: repair"];
