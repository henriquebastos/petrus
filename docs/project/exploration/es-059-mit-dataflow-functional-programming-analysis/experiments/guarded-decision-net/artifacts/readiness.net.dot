  }
  subgraph "cluster_2" {
    graph [color="#8b949e", fillcolor="#161b22", fontcolor="#8b949e", label="events", style="filled", tooltip="events"];
    "p7" [color="#58a6ff", fillcolor="#0d1117", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">ci</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">CIObserved</FONT></TD></TR></TABLE>>, shape="ellipse", style="filled", tooltip="events.ci"];
  }
  subgraph "cluster_3" {
    graph [color="#8b949e", fillcolor="#161b22", fontcolor="#8b949e", label="facts", style="filled", tooltip="facts"];
