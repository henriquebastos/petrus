    "t7" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">fire</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="readiness.accept_publish.fire\nhandler: anonymous declaration"];
    "t8" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">fire</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler · guard</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="readiness.route_ci.human.fire\nhandler: anonymous declaration\nguards: anonymous declaration"];
    "t9" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">fire</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler · guard</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="readiness.route_ci.ignore.fire\nhandler: anonymous declaration\nguards: anonymous declaration"];
    "t10" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">fire</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler · guard</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="readiness.route_ci.publish.fire\nhandler: anonymous declaration\nguards: anonymous declaration"];
    "t11" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">fire</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler · guard</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="readiness.route_ci.repair.fire\nhandler: anonymous declaration\nguards: anonymous declaration"];
    "t12" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">fire</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">handler · guard</FONT></TD></TR></TABLE>>, shape="box", style="rounded,filled", tooltip="readiness.route_ci.rerun.fire\nhandler: anonymous declaration\nguards: anonymous declaration"];
