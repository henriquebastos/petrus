digraph "impetus" {
  graph [bgcolor="#0d1117", fontcolor="#e6edf3", fontname="Helvetica", label="readiness", labelloc="t", nodesep="0.6", pad="0.25", rankdir="TB", ranksep="1.0"];
  node [fontcolor="#e6edf3", fontname="Helvetica"];
  edge [fontcolor="#8b949e", fontname="Helvetica", fontsize="10"];
  subgraph "cluster_0" {
    graph [color="#8b949e", fillcolor="#161b22", fontcolor="#8b949e", label="commands", style="filled", tooltip="commands"];
    "p0" [color="#58a6ff", fillcolor="#0d1117", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">publish</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">PublishRequested</FONT></TD></TR></TABLE>>, shape="ellipse", style="filled", tooltip="commands.publish"];
