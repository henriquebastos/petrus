    "p13" [color="#58a6ff", fillcolor="#0d1117", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">published</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">Published</FONT></TD></TR></TABLE>>, shape="ellipse", style="filled", tooltip="terminal.published"];
