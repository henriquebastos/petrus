  subgraph "cluster_6" {
    graph [color="#8b949e", fillcolor="#161b22", fontcolor="#8b949e", label="ingress", style="filled", tooltip="ingress"];
    "t5" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">ci</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">source</FONT></TD></TR></TABLE>>, penwidth="2", shape="box", style="rounded,filled,dashed", tooltip="ingress.ci\nsource transition"];
    "t6" [color="#d29922", fillcolor="#161b22", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="1"><TR><TD><B><FONT COLOR="#e6edf3" POINT-SIZE="14">head</FONT></B></TD></TR><TR><TD><FONT COLOR="#8b949e" POINT-SIZE="9">source · handler</FONT></TD></TR></TABLE>>, penwidth="2", shape="box", style="rounded,filled,dashed", tooltip="ingress.head\nsource transition\nhandler: anonymous declaration"];
  }
